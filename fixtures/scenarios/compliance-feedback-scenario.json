{
  "scenarioId": "scenario-compliance-001",
  "title": "Missing KYC evidence review",
  "agentFamily": "tool_chain",
  "taskFamily": "compliance",
  "difficulty": "medium",
  "modalityProfile": ["text", "pdf"],
  "caseBrief": "Review the synthetic case and identify any missing KYC evidence before the case can proceed.",
  "environmentSeed": "seed-compliance-001",
  "artifacts": [
    {
      "artifactId": "artifact-policy-kyc",
      "kind": "policy",
      "title": "KYC onboarding policy",
      "path": "policies/kyc-onboarding-policy.pdf",
      "mimeType": "application/pdf"
    }
  ],
  "availableDataSources": [
    {
      "sourceId": "customer-db",
      "kind": "database",
      "description": "Synthetic customer onboarding records"
    }
  ],
  "availableTools": ["policy_search", "customer_lookup"],
  "syntheticPackReferences": [
    {
      "referenceId": "pack-ref-compliance-core",
