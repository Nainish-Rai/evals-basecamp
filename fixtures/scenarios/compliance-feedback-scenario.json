      "materializationTargets": ["artifacts", "data_sources"],
      "destinationPath": "workspace/reference"
    }
  ],
  "materialization": {
    "workspaceRoot": "workspace/case",
    "includeScenarioArtifacts": true,
    "syntheticPackReferenceOrder": ["pack-ref-compliance-core"]
  },
  "expectedOutcomes": [
    {
      "findingId": "finding-missing-proof-of-address",
      "summary": "The customer file is missing valid proof of address.",
      "severity": "high",
      "requiredEvidenceRefs": ["artifact-policy-kyc"],
      "requiredPolicyRefs": ["kyc.section.4"]
    }
  ],
  "trajectoryHints": {
    "expectedNodes": ["planToolWork", "executeTool", "applyFeedback", "composeFinalAnswer"],
    "expectedTools": ["policy_search", "customer_lookup"],
    "allowAdditionalSteps": true
