  "feedbackTurns": [
    {
      "feedbackId": "feedback-proof-of-address",
      "turnId": "turn-2",
      "source": "reviewer",
      "summary": "The first draft missed the proof-of-address requirement.",
      "instructions": [
        "Re-check the customer onboarding checklist.",
        "Update the final finding to include the missing document."
      ],
      "correctedFacts": [
        "Proof of address is mandatory for this customer type."
      ],
      "priority": "high",
      "resolution": "pending"
    }
  ],
  "memoryTargets": [
    {
      "targetId": "retain-proof-of-address-rule",
      "description": "Retain the corrected proof-of-address requirement after reviewer feedback.",
      "mustRetainAfterFeedback": true
    }
  ],
  "memoryEvaluationSpec": {
    "memorySources": ["user"],
    "memoryScope": "case",
    "memoryOpportunities": [
      {
        "opportunityId": "memory-opportunity-proof-of-address",
        "summary": "The reviewer corrected the case with a missing proof-of-address requirement.",
        "source": "user",
        "scope": "case",
        "worthKeeping": true,
        "neededLater": true,
        "relatedTurnIds": ["turn-2"]
      }
    ],
    "memoryCheckpoints": [
      {
        "checkpointId": "memory-checkpoint-feedback-rerun",
        "turnId": "turn-2",
        "expectedAction": "retrieve",
        "relatedOpportunityIds": ["memory-opportunity-proof-of-address"],
        "rationale": "The rerun should retrieve and apply the reviewer correction."
      }
    ],
    "expectedMemoryState": "correct_save_correct_needed_retrieval",
    "expectedMemoryImpact": "positive"
  },
  "evaluationRubric": {
    "requiredChecks": ["identify_missing_document", "cite_policy_source"],
    "optionalChecks": ["recommend_case_escalation"],
