{
  "packId": "pack-risk-core-v1",
  "taskFamily": "risk",
  "version": "1.0.0",
  "description": "Synthetic risk records for control scoring, residual risk, and ambiguity-sensitive benchmark cases.",
  "entries": [
    {
      "entryId": "risk-entry-01",
      "title": "Residual risk register update",
      "summary": "Risk scoring case with clear minimum context and reviewer feedback about residual impact.",
      "tags": ["minimal-context", "feedback", "risk-register"],
      "artifacts": [
        {
          "artifactId": "pack-risk-01-register",
          "kind": "spreadsheet",
          "title": "Residual risk register",
          "path": "packs/risk/residual-risk-register.xlsx",
          "mimeType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
        }
      ],
      "dataSources": [
        {
          "sourceId": "pack-risk-01-db",
          "kind": "database",
          "description": "Synthetic residual risk score history"
        }
      ],
      "facts": {
        "riskTheme": "vendor_access",
        "residualRiskBand": "high"
      }
    },
    {
      "entryId": "risk-entry-02",
      "title": "Inherent risk scoring challenge",
      "summary": "Trajectory-sensitive case with prompt and tool ambiguity that can trigger avoidable retries.",
      "tags": ["trajectory", "ambiguity", "over-context"],
      "artifacts": [
        {
          "artifactId": "pack-risk-02-matrix",
          "kind": "document",
          "title": "Risk scoring matrix excerpts",
          "path": "packs/risk/risk-scoring-matrix.md",
          "mimeType": "text/markdown"
        }
      ],
      "dataSources": [
        {
          "sourceId": "pack-risk-02-search",
          "kind": "search_index",
          "description": "Synthetic risk scoring glossary and examples"
        }
      ],
      "facts": {
        "ambiguousMetric": "customer_exposure_score",
        "retryRisk": "prompt_tool_mismatch"
      }
    },
    {
      "entryId": "risk-entry-03",
      "title": "Duplicate register consolidation",
      "summary": "Duplicate-context risk case where the agent should avoid saving low-value repeated state.",
      "tags": ["duplicate-context", "quality-preserving", "pattern-memory"],
      "artifacts": [
        {
          "artifactId": "pack-risk-03-registers",
          "kind": "dataset",
          "title": "Duplicate risk register extracts",
          "path": "packs/risk/duplicate-register-extracts.json",
          "mimeType": "application/json"
        }
      ],
      "dataSources": [
        {
          "sourceId": "pack-risk-03-files",
          "kind": "filesystem",
          "description": "Synthetic folder with duplicated risk register snapshots"
        }
      ],
      "facts": {
        "duplicateSnapshotCount": 3,
        "expectedDecision": "deduplicate_before_scoring"
      }
    },
    {
      "entryId": "vendor-overview-case",
      "title": "Vendor attestation over-context case",
      "summary": "Vendor risk package with redundant historical assessments and a current attestation gap.",
      "tags": ["over-context", "vendor", "attestation"],
      "artifacts": [
        {
          "artifactId": "pack-risk-04-vendor",
          "kind": "document",
          "title": "Vendor attestation summary",
          "path": "packs/risk/vendor-attestation-summary.md",
          "mimeType": "text/markdown"
        }
      ],
      "dataSources": [
        {
          "sourceId": "pack-risk-04-db",
          "kind": "database",
          "description": "Synthetic vendor assessment history and attestation status"
        }
      ],
      "facts": {
        "missingCurrentAttestation": true,
        "redundantHistoricalAssessments": 3
      }
    },
    {
      "entryId": "multimodal-loss-case",
      "title": "Operational loss multimodal reconciliation",
      "summary": "Heatmap and incident table pair for multimodal operational loss review.",
      "tags": ["multimodal", "feedback", "workspace"],
      "artifacts": [
        {
          "artifactId": "pack-risk-05-heatmap",
          "kind": "image",
          "title": "Operational loss heatmap",
          "path": "packs/risk/operational-loss-heatmap.png",
          "mimeType": "image/png"
        }
      ],
      "dataSources": [
        {
          "sourceId": "pack-risk-05-api",
          "kind": "api",
          "description": "Synthetic operational loss incident table API"
        }
      ],
      "facts": {
        "dominantLossTheme": "manual_override_failures",
        "requiresMultimodalSummary": true
      }
    },
    {
      "entryId": "liquidity-ambiguity-case",
      "title": "Liquidity ambiguity retry case",
      "summary": "Liquidity ratio case with overlapping tool surfaces and terminology drift.",
      "tags": ["ambiguity", "retry", "tool-overlap"],
      "artifacts": [
        {
          "artifactId": "pack-risk-06-liquidity",
          "kind": "dataset",
          "title": "Liquidity ambiguity dataset",
          "path": "packs/risk/liquidity-ambiguity-dataset.json",
          "mimeType": "application/json"
        }
      ],
      "dataSources": [
        {
          "sourceId": "pack-risk-06-db",
          "kind": "database",
          "description": "Synthetic liquidity coverage ratio history with ambiguous labels"
        }
      ],
      "facts": {
        "policyTerm": "liquidity_coverage_ratio",
        "legacyLabel": "buffer"
      }
    }
  ]
}
